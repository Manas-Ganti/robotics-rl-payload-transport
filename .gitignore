__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Checkpoints / logs
*.pt
*.pth
*.tfevents.*

# Editor / OS
.vscode/
.idea/
.DS_Store

# Machine-local Claude Code settings
.claude/settings.local.json
